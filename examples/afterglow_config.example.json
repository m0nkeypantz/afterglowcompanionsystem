  },
  "companion_memory": {
    "enabled": true,
    "observation_scan_limit": 6000,
    "episode_days": 21,
    "small_stuff_limit": 12,
    "relationship_edge_days": 30,
    "relationship_core_entities": [],
    "custom_relationship_predicates": [],
    "prompt_leak_quarantine": true,
    "trace_recall": true
  },
  "ui": {
    "host": "127.0.0.1",
    "port": 8765
  }
}
